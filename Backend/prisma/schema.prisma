generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  priceCents  Int
  currency    String   @default("USD")
  imageUrl    String
  category    String
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  placements ProductPlacement[]
}

/// Where a product sits on the outro film's shoppable scenes.
///
/// This is a separate table rather than columns on Product because a single
/// product legitimately appears in more than one scene — the Aria Lounge
/// Chair, Haven Sectional and Orbit Coffee Table are all in both the day
/// room and the evening room, and the Glow Table Lamp is in the evening
/// room and the dining room. One scene column could not express that.
model ProductPlacement {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// day-room | evening-room | dining | bedroom | terrace
  scene String

  /// Position as a percentage of the 1280x720 FOOTAGE, not of the screen.
  /// OutroScene's projectSpot() runs these through the canvas's cover
  /// transform so a dot stays on its furniture at any viewport size.
  x Float
  y Float

  /// Optional start position. The terrace scene pushes the camera in, so
  /// its dots lerp from (x0,y0) to (x,y) across the window. Null elsewhere.
  x0 Float?
  y0 Float?

  /// Which way the product card opens, so cards near an edge stay on screen.
  side String @default("right")

  /// Order of the dots WITHIN a scene. Load-bearing: the camera-track lerp
  /// matches cached DOM nodes to hotspots positionally, so an unstable
  /// order would swap dots between pieces of furniture.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, scene])
  @@index([scene])
}

model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String    @default("site-footer")
  createdAt      DateTime  @default(now())
  unsubscribedAt DateTime?
}

model Inquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

// Maple 3D production is independent from the commerce Product catalogue.
model ThreeDProduct {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  sourceType         String   @default("manual")
  sourceTenantId     String?
  sourceModelId      String?
  sourceRevision     String?
  publishedVersionId String?  @unique
  publishedVersion   ThreeDVersion? @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: Restrict)
  imports            ThreeDImport[]
  jobs               ThreeDJob[]
  assets             ThreeDAsset[]
  versions           ThreeDVersion[] @relation("ProductVersions")
  publications       ThreeDPublication[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([sourceTenantId, sourceModelId])
}

model ThreeDImport {
  id             String   @id @default(cuid())
  productId      String
  product        ThreeDProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  sourceRevision String
  snapshot       Json
  jobs           ThreeDJob[]
  createdAt      DateTime @default(now())

  @@unique([productId, sourceRevision])
}

model ThreeDJob {
  id             String @id @default(cuid())
  productId      String
  product        ThreeDProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  recipeId       String
  recipeVersion  Int
  idempotencyKey String
  status         ThreeDJobStatus @default(awaiting_delivery)
  importId       String?
  sourceImport   ThreeDImport? @relation(fields: [importId], references: [id], onDelete: Restrict)
  inputSnapshot  Json
  geometryGroupId String?
  version        ThreeDVersion?
  createdAt      DateTime @default(now())
  completedAt    DateTime?

  @@unique([productId, idempotencyKey])
}

enum ThreeDJobStatus {
  awaiting_delivery
  completed
}

model ThreeDAsset {
  id          String @id @default(cuid())
  productId   String
  product     ThreeDProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  kind        ThreeDAssetKind
  filename    String
  contentType String
  sizeBytes   Int
  sha256      String
  storageKey  String @unique
  masterVersions ThreeDVersion[] @relation("VersionMaster")
  createdAt   DateTime @default(now())

  @@index([productId])
}

enum ThreeDAssetKind {
  web_model
  blender_master
  preview
  texture
  reference
}

model ThreeDVersion {
  id          String @id @default(cuid())
  productId   String
  product     ThreeDProduct @relation("ProductVersions", fields: [productId], references: [id], onDelete: Restrict)
  publishedBy ThreeDProduct? @relation("PublishedVersion")
  sequence    Int
  productName String
  sourceRevision String?
  geometryGroupId String?
  masterAssetId String?
  masterAsset ThreeDAsset? @relation("VersionMaster", fields: [masterAssetId], references: [id], onDelete: Restrict)
  jobId       String? @unique
  job         ThreeDJob? @relation(fields: [jobId], references: [id], onDelete: Restrict)
  manifest    Json
  notes       String @default("")
  status      ThreeDVersionStatus @default(draft)
  reviewNotes String?
  reviewedAt  DateTime?
  reviewedBy  String?
  publications ThreeDPublication[]
  createdAt   DateTime @default(now())

  @@unique([productId, sequence])
}

enum ThreeDVersionStatus {
  draft
  approved
  rejected
}

model ThreeDPublication {
  id                String @id @default(cuid())
  productId         String
  product           ThreeDProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  versionId         String
  version           ThreeDVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  previousVersionId String?
  publishedBy       String
  createdAt         DateTime @default(now())

  @@index([productId, createdAt])
}


// Durable one-page input scans. A separate worker imports the pinned item revisions.
model ThreeDImportBatch {
  id             String @id @default(cuid())
  tenantId       String
  idempotencyKey String
  requestedBy    String
  status         ThreeDImportBatchStatus @default(queued)
  cursor         String?
  nextCursor     String?
  listLoadedAt   DateTime?
  bytesReserved  Int @default(0)
  attempts       Int @default(0)
  errorCode      String?
  errorMessage   String?
  leaseToken     String?
  leaseExpiresAt DateTime?
  attemptDeadline DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  items          ThreeDImportItem[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
}

enum ThreeDImportBatchStatus {
  queued
  running
  completed
  failed
  cancelled
}

model ThreeDImportItem {
  id             String @id @default(cuid())
  batchId        String
  batch          ThreeDImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  position       Int
  modelId        String
  name           String
  code           String
  sourceRevision String
  status         ThreeDImportItemStatus @default(pending)
  attempts       Int @default(0)
  productId      String?
  errorCode      String?
  errorMessage   String?
  completedAt    DateTime?

  @@unique([batchId, modelId])
  @@unique([batchId, position])
}

enum ThreeDImportItemStatus {
  pending
  running
  imported
  unchanged
  failed
  cancelled
}
