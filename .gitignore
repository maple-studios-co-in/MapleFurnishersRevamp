# --- Next.js apps (Frontend, AdminDashboard, ...) ---
# Bare patterns so every workspace's build output is covered — the
# AdminDashboard/.next cache once slipped into a commit via the old
# Frontend-only rule.
.next/
out/
build/
next-env.d.ts

# --- Backend (placeholder for when it lands) ---
Backend/dist/
Backend/build/

# vercel
.vercel

# Raw frame sequences (~1 GB of source PNGs). Build inputs only —
# `npm run frames:*` regenerates everything served from public/media/.
.assets-src/

# Local agent/editor tooling (machine-specific paths, launch configs)
.claude/
.env*
